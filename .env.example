# Copy to .env (never commit .env). Only the synthetic-data step (generate_synthetic.py, grade_gpt.py) needs the Forgehand values.
DATA_DIR=/data
# Forgehand team UUID for the team-scoped LLM API (GPT-6 Sol/Luna) used to generate training data
FORGEHAND_TEAM_ID=<your-team-uuid>
# Optional: Forgehand access token; if unset, the token from `fh login` (DATA_DIR/.config/forgehand/config.json) is used
# FORGEHAND_TOKEN=<token>
